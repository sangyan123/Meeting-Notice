/**app.wxss — 全局样式**/
page {
  --primary: #1A6DFF;
  --primary-dark: #155FE6;
  --primary-light: #EAF2FF;
  --bg: #F3F7FF;
  --card: #ffffff;
  --text: #1F2A37;
  --text-secondary: #708095;
  --text-muted: #9AA6B6;
  --border: #EDF2F9;
  --gold: #FFC845;
  background-color: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  box-sizing: border-box;
}

view, text, image, button, scroll-view {
  box-sizing: border-box;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 20rpx;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.section-title::before {
  content: '';
  width: 8rpx;
  height: 28rpx;
  background: var(--primary);
  border-radius: 4rpx;
  margin-right: 14rpx;
}

.section-link {
  font-size: 24rpx;
  color: var(--primary);
}

.card {
  margin: 0 24rpx;
  background: var(--card);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(31, 66, 135, 0.06);
}

.chevron {
  color: #C3CDDA;
  font-size: 28rpx;
  margin-left: 12rpx;
}
