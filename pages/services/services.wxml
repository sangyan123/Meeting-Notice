<!--pages/services/services.wxml-->
<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar">
      <view class="nav-back" bindtap="onBack">‹</view>
      <text class="nav-title">会务服务</text>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <view class="header">
    <view class="header-content">
      <text class="header-title">会务服务</text>
      <text class="header-sub">为代表提供会议期间综合服务</text>
    </view>
  </view>

  <view class="body">
    <view class="card service-card">
      <view class="service-grid">
        <view
          class="service-item"
          wx:for="{{services}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onServiceTap"
        >
          <view class="service-icon" style="background: {{item.bg}};">
            <image class="service-img" src="{{item.img}}" mode="aspectFit" />
          </view>
          <text class="service-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="card contact-card">
      <text class="contact-title">秘书处联系方式</text>
      <view class="contact-list">
        <view
          class="contact-row"
          wx:for="{{contacts}}"
          wx:key="label"
          data-phone="{{item.phone}}"
          bindtap="onContactTap"
        >
          <text class="contact-label">{{item.label}}</text>
          <text class="contact-value {{item.phone ? 'callable' : ''}}">{{item.value}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
