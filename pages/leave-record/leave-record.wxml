<!--pages/leave-record/leave-record.wxml-->
<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar">
      <view class="nav-back" bindtap="onBack">‹</view>
      <text class="nav-title">请假记录</text>
      <view class="new-btn" bindtap="onNew">+ 新申请</view>
    </view>
  </view>

  <view class="body">
    <view
      class="record-card"
      wx:for="{{records}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onRecordTap"
    >
      <view class="record-top">
        <text class="record-title">{{item.title}}</text>
        <text class="record-status status-{{item.status}}">{{item.statusText}}</text>
      </view>
      <view class="record-row">
        <image class="record-icon" src="/assets/icons/date.png" mode="aspectFit" />
        <text>{{item.date}}</text>
      </view>
      <view class="record-reason">原因：{{item.reason}}</view>
    </view>
    <view class="empty" wx:if="{{!records.length}}">暂无请假记录</view>
  </view>

  <!-- 请假申请详情弹窗 -->
  <view class="modal-mask {{selectedRecord ? 'show' : ''}}" wx:if="{{selectedRecord}}" bindtap="onCloseDetail">
    <view class="detail-sheet" catchtap="stopPropagation">
      <view class="sheet-handle"></view>
      <view class="sheet-top">
        <text class="sheet-title">{{selectedRecord.title}}</text>
        <text class="record-status status-{{selectedRecord.status}}">{{selectedRecord.statusText}}</text>
      </view>
      <view class="sheet-row">
        <text class="sheet-label">会议日期</text>
        <text class="sheet-value">{{selectedRecord.date}}</text>
      </view>
      <view class="sheet-row">
        <text class="sheet-label">审批人</text>
        <text class="sheet-value">{{selectedRecord.approver}}</text>
      </view>
      <view class="sheet-reason">
        <text class="sheet-label">请假原因</text>
        <text class="reason-text">{{selectedRecord.reason}}</text>
      </view>
    </view>
  </view>
</view>
