/* pages/index/index.wxss */
.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 20rpx;
}

.header {
  background: var(--primary);
  padding: 24rpx 32rpx 40rpx;
  position: relative;
}

/* 红头底部金色分隔线 */
.header-line {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 4rpx;
  background: var(--gold);
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.brand {
  display: flex;
  align-items: flex-start;
  flex: 1;
  padding-right: 24rpx;
}

.emblem {
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 24rpx;
  margin-top: 0;
}

.emblem-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.brand-text {
  display: flex;
  flex-direction: column;
}

.brand-org {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 6rpx;
}

.brand-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.3;
  margin-bottom: 8rpx;
}

.brand-date {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

.bell-wrap {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: center;
  flex-shrink: 0;
}

.bell-img {
  width: 64rpx;
  height: 64rpx;
}

.bell-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  background: #F5C518;
  color: #333;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 15rpx;
  border: 2rpx solid #B31A21;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-nav {
  display: flex;
  margin-top: 10rpx;
  gap: 20rpx;
}

.quick-item {
  flex: 1;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(212, 175, 55, 0.45);
  border-radius: 20rpx;
  padding: 16rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.quick-img {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 8rpx;
}

.quick-label {
  font-size: 28rpx;
  color: #ffffff;
}

.meeting-item,
.notice-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid #F0EEE8;
}

.meeting-item:last-child,
.notice-item:last-child {
  border-bottom: none;
}

.meeting-main,
.notice-main {
  display: flex;
  align-items: flex-start;
  flex: 1;
  min-width: 0;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--primary);
  margin-top: 12rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.meeting-info,
.notice-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.meeting-title,
.notice-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.meeting-meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  gap: 24rpx;
}

.meta-line {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.meta-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.detail-btn {
  flex-shrink: 0;
  margin-left: 20rpx;
  background: var(--primary);
  color: #ffffff;
  font-size: 26rpx;
  padding: 14rpx 32rpx;
  border-radius: 12rpx;
}

.notice-card {
  margin-bottom: 24rpx;
}

.notice-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.tag-pre {
  background: #E8F3FC;
  color: #3A8FD6;
}

.tag-mid {
  background: #FDECED;
  color: #C82439;
}

.notice-time {
  font-size: 22rpx;
  color: var(--text-muted);
}

.safe-bottom {
  height: 40rpx;
}
