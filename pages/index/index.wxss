/* pages/index/index.wxss */
.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 24rpx;
}

.header {
  position: relative;
  overflow: hidden;
  background-color: #155FE6;
  padding: 24rpx 32rpx 44rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.header-top {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.brand {
  display: flex;
  align-items: center;
  flex: 1;
  padding-right: 24rpx;
}

.emblem {
  width: 112rpx;
  height: 112rpx;
  border-radius: 24rpx;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.emblem-img {
  width: 82rpx;
  height: 82rpx;
  border-radius: 50%;
}

.brand-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.brand-user {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.3;
  margin-bottom: 8rpx;
}

.brand-org {
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.94);
  margin-bottom: 8rpx;
}

.brand-date {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.76);
}

.bell-wrap {
  position: relative;
  width: 77rpx;
  height: 77rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: center;
  flex-shrink: 0;
}

.bell-img {
  width: 55rpx;
  height: 55rpx;
  filter: brightness(10);
}

.bell-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  background: #FFC845;
  color: #333;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.header-line {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 5rpx;
  background: var(--gold);
}

.body {
  padding-bottom: 20rpx;
}

.form-entry {
  margin: 24rpx;
  height: 112rpx;
  padding: 0 28rpx;
  background: #ffffff;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 6rpx 20rpx rgba(31, 66, 135, 0.06);
}

.entry-left {
  display: flex;
  align-items: center;
  min-width: 0;
}

.entry-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.entry-label {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.meeting-item,
.notice-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  border-bottom: 1rpx solid var(--border);
}

.meeting-item:last-child,
.notice-item:last-child {
  border-bottom: none;
}

.meeting-main,
.notice-main {
  display: flex;
  align-items: flex-start;
  flex: 1;
  min-width: 0;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--primary);
  margin: 14rpx 16rpx 0 0;
  flex-shrink: 0;
}

.meeting-info,
.notice-info {
  flex: 1;
  min-width: 0;
}

.meeting-title,
.notice-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.4;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.meeting-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.meta-line {
  display: flex;
  align-items: center;
  font-size: 23rpx;
  color: var(--text-secondary);
}

.meta-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.detail-btn {
  flex-shrink: 0;
  min-width: 92rpx;
  height: 52rpx;
  padding: 0 20rpx;
  margin-left: 20rpx;
  border-radius: 26rpx;
  background: var(--primary);
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.notice-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.tag-pre {
  background: #E8F3FF;
  color: #2280FF;
}

.tag-mid {
  background: #EAF2FF;
  color: #1A6DFF;
}

.tag-post {
  background: #F1F5FB;
  color: #708095;
}

.notice-time {
  font-size: 22rpx;
  color: var(--text-muted);
}

.empty-tip {
  padding: 64rpx 0;
  text-align: center;
  color: var(--text-muted);
  font-size: 25rpx;
}

.safe-bottom {
  height: env(safe-area-inset-bottom);
}

