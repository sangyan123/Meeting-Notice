/* pages/index/index.wxss */
.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 20rpx;
}

.header {
  background: var(--primary);
  padding: 24rpx 32rpx 40rpx;
  position: relative;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.brand {
  display: flex;
  align-items: flex-start;
  flex: 1;
  padding-right: 24rpx;
}

.emblem {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #F0D78C, #C9A227);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
  margin-top: 16rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.35);
}

.emblem-text {
  font-size: 32rpx;
  color: #8B6914;
  font-weight: 700;
}

.brand-text {
  display: flex;
  flex-direction: column;
}

.brand-org {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 6rpx;
}

.brand-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.3;
  margin-bottom: 8rpx;
}

.brand-date {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

.bell-wrap {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bell-icon {
  font-size: 40rpx;
  line-height: 1;
  filter: brightness(10);
}

.bell-badge {
  position: absolute;
  top: 0;
  right: 0;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  background: #F5C518;
  color: #333;
  font-size: 18rpx;
  font-weight: 700;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-nav {
  display: flex;
  margin-top: 36rpx;
  gap: 16rpx;
}

.quick-item {
  flex: 1;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 16rpx;
  padding: 24rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.quick-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
  line-height: 1;
}

.quick-label {
  font-size: 24rpx;
  color: #ffffff;
}

.meeting-item,
.notice-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid #F0EEE8;
}

.meeting-item:last-child,
.notice-item:last-child {
  border-bottom: none;
}

.meeting-main,
.notice-main {
  display: flex;
  align-items: flex-start;
  flex: 1;
  min-width: 0;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--primary);
  margin-top: 14rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.meeting-info,
.notice-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.meeting-title,
.notice-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.meeting-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.meta-line {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.detail-btn {
  flex-shrink: 0;
  margin-left: 20rpx;
  background: var(--primary);
  color: #ffffff;
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 8rpx;
}

.notice-card {
  margin-bottom: 24rpx;
}

.notice-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.tag-pre {
  background: #E8F3FC;
  color: #3A8FD6;
}

.tag-mid {
  background: #FDECED;
  color: #C82439;
}

.notice-time {
  font-size: 22rpx;
  color: var(--text-muted);
}

.safe-bottom {
  height: 40rpx;
}
