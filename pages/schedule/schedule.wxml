<!--pages/schedule/schedule.wxml-->
<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar">
      <text class="nav-title">日程</text>
    </view>
  </view>

  <view class="segment">
    <view class="segment-item {{activeTab === 'pending' ? 'active' : ''}}" data-tab="pending" bindtap="onTabChange">
      <text>待开会议</text>
    </view>
    <view class="segment-item {{activeTab === 'history' ? 'active' : ''}}" data-tab="history" bindtap="onTabChange">
      <text>历史会议</text>
    </view>
  </view>

  <view class="body">
    <view class="empty" wx:if="{{loading}}">日程加载中...</view>
    <block wx:else>
      <view
        class="meeting-card"
        wx:for="{{currentMeetings}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onMeetingTap"
      >
        <view class="card-main">
          <text class="card-title">{{item.name}}</text>
          <view class="card-meta">
            <view class="meta-item">
              <image class="meta-icon" src="/assets/icons/date.png" mode="aspectFit" />
              <text>{{item.dateText}}</text>
            </view>
            <view class="meta-item">
              <image class="meta-icon" src="/assets/icons/meta-clock.png" mode="aspectFit" />
              <text>{{item.time}}</text>
            </view>
            <view class="meta-item">
              <image class="meta-icon" src="/assets/icons/meta-location.png" mode="aspectFit" />
              <text>{{item.place}}</text>
            </view>
          </view>
        </view>
        <text class="card-arrow">›</text>
      </view>
      <view class="empty" wx:if="{{currentMeetings.length === 0}}">
        {{activeTab === 'pending' ? '暂无待开会议' : '暂无历史会议'}}
      </view>
    </block>
  </view>
  <view class="safe-bottom"></view>
</view>
