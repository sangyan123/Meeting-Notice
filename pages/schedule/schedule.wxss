/* pages/schedule/schedule.wxss */
.page {
  min-height: 100vh;
  background: var(--bg);
}

.nav {
  background: var(--primary);
}

.nav-bar {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
}

.segment {
  display: flex;
  background: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(31, 66, 135, 0.05);
}

.segment-item {
  position: relative;
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
  font-size: 29rpx;
}

.segment-item.active {
  color: var(--primary);
  font-weight: 700;
}

.segment-item.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 10rpx;
  width: 52rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: var(--primary);
  transform: translateX(-50%);
}

.body {
  padding: 24rpx;
}

.meeting-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 66, 135, 0.06);
}

.card-main {
  flex: 1;
  min-width: 0;
}

.card-title {
  display: block;
  font-size: 29rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.card-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 18rpx;
}

.meta-item {
  display: inline-flex;
  align-items: center;
  min-width: 0;
  font-size: 23rpx;
  color: var(--text-secondary);
}

.meta-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.card-arrow {
  color: #C3CDDA;
  font-size: 32rpx;
  margin-left: 12rpx;
}

.empty {
  padding: 90rpx 0;
  text-align: center;
  color: var(--text-muted);
  font-size: 26rpx;
}

.safe-bottom {
  height: env(safe-area-inset-bottom);
}
