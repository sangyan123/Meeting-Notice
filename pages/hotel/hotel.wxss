@import "../../styles/service-page.wxss";

.addr-line {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  margin-bottom: 20rpx;
}

.addr-pin {
  margin-right: 8rpx;
  font-size: 28rpx;
}

.addr-text {
  font-size: 26rpx;
  color: var(--text);
}

.map-box {
  background: #F0EEE8;
  border-radius: 16rpx;
  height: 220rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.map-pin {
  font-size: 40rpx;
  color: var(--primary);
  margin-bottom: 8rpx;
}

.map-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 6rpx;
}

.map-dist {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.tip-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0EEE8;
}

.tip-item:last-child {
  border-bottom: none;
}

.tip-num {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #ffffff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 16rpx;
  margin-top: 2rpx;
}

.tip-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.5;
}
