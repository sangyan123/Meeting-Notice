/* pages/contact-secretary/contact-secretary.wxss */
.page {
  min-height: 100vh;
  background: var(--bg);
}

.nav {
  background: var(--primary);
}

.nav-bar {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-back,
.nav-placeholder {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 56rpx;
  font-weight: 300;
  line-height: 1;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
}

.body {
  padding: 24rpx;
}

.hotline-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 66, 135, 0.06);
}

.hotline-title {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 18rpx;
}

.hotline-phone {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary);
  letter-spacing: 1rpx;
}

.section-title {
  padding: 28rpx 8rpx 16rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 6rpx 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 66, 135, 0.06);
}

.group-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.group-item:last-child {
  border-bottom: none;
}

.group-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.group-name {
  font-size: 29rpx;
  font-weight: 700;
  color: var(--text);
}

.group-tag {
  flex-shrink: 0;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 7rpx 14rpx;
  border-radius: 20rpx;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 20rpx;
}

.group-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.group-contact {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.group-phone {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary);
}

.safe-bottom {
  height: env(safe-area-inset-bottom);
}
