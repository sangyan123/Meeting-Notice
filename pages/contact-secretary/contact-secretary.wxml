<!--pages/contact-secretary/contact-secretary.wxml-->
<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar">
      <view class="nav-back" bindtap="onBack">‹</view>
      <text class="nav-title">联系秘书处</text>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <view class="body">
    <view class="hotline-card" data-phone="{{hotline.phone}}" bindtap="onCall">
      <text class="hotline-title">{{hotline.title}}</text>
      <text class="hotline-phone">{{hotline.phone}}</text>
    </view>

    <view class="section-title">各工作组联系方式</view>

    <view class="card">
      <view
        class="group-item"
        wx:for="{{groups}}"
        wx:key="id"
        data-phone="{{item.phone}}"
        bindtap="onCall"
      >
        <view class="group-top">
          <text class="group-name">{{item.name}}</text>
          <text class="group-tag">{{item.tag}}</text>
        </view>
        <view class="group-bottom">
          <text class="group-contact">{{item.contact}}</text>
          <text class="group-phone">{{item.phone}}</text>
        </view>
      </view>
    </view>

    <view class="safe-bottom"></view>
  </view>
</view>
