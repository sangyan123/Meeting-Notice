@import "../../styles/service-page.wxss";

/* ---- 顶部导航 ---- */
.nav {
  background: var(--primary);
}

.nav-bar {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
}

/* ---- 表单卡片 ---- */
.body {
  padding: 24rpx;
}

.form-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 12rpx 32rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 66, 135, 0.06);
}

.field {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F0F3F8;
}

.field-last {
  border-bottom: none;
  padding-bottom: 12rpx;
}

.field-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 14rpx;
}

.field-value {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.4;
}

/* ---- 日期选择行 ---- */
.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.picker-row.placeholder {
  color: #B9C2CE;
  font-weight: 400;
}

.date-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

/* ---- 请假原因 ---- */
.textarea {
  width: 100%;
  min-height: 220rpx;
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.5;
  box-sizing: border-box;
}

.ph {
  color: #B9C2CE;
}

/* ---- 提交按钮 ---- */
.submit-btn {
  margin-top: 32rpx;
  height: 92rpx;
  border-radius: 20rpx;
  background: #C8C4BB;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s ease;
}

.submit-btn.ready {
  background: var(--primary);
}

/* 纸飞机图标（内嵌 SVG） */
.btn-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  background-color: #ffffff;
  -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M2.01 21L23 12 2.01 3 2 10l15 2-15 2z'/></svg>");
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
  mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M2.01 21L23 12 2.01 3 2 10l15 2-15 2z'/></svg>");
  mask-repeat: no-repeat;
  mask-position: center;
  mask-size: contain;
}
