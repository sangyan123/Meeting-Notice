<!--pages/leave/leave.wxml-->
<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar">
      <view class="nav-back" bindtap="onBack">‹</view>
      <text class="nav-title">请假申请</text>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <view class="tabs">
    <view class="tab {{activeTab === 'apply' ? 'active' : ''}}" data-tab="apply" bindtap="onTab">申请请假</view>
    <view class="tab {{activeTab === 'records' ? 'active' : ''}}" data-tab="records" bindtap="onTab">请假记录</view>
  </view>

  <!-- 申请表 -->
  <view class="body" wx:if="{{activeTab === 'apply'}}">
    <view class="card form-card">
      <text class="card-title">请假申请表</text>

      <view class="field">
        <text class="field-label">请假会议 <text class="req">*</text></text>
        <view class="dropdown">
          <view
            class="dropdown-trigger {{meetingOpen ? 'open' : ''}} {{meetingIndex < 0 ? 'placeholder' : ''}}"
            catchtap="onToggleMeeting"
          >
            <text>{{meetingIndex < 0 ? '请选择请假会议' : meetings[meetingIndex]}}</text>
            <text class="arrow">{{meetingOpen ? '∧' : '∨'}}</text>
          </view>
          <view class="dropdown-panel" wx:if="{{meetingOpen}}">
            <view
              class="dropdown-item {{meetingIndex === index ? 'active' : ''}}"
              wx:for="{{meetings}}"
              wx:key="*this"
              data-index="{{index}}"
              catchtap="onSelectMeeting"
            >{{item}}</view>
          </view>
        </view>
      </view>

      <view class="field">
        <text class="field-label">请假原因 <text class="req">*</text></text>
        <textarea
          class="textarea"
          placeholder="请填写请假原因（不少于10字）"
          maxlength="200"
          value="{{reason}}"
          bindinput="onReasonInput"
        />
        <text class="counter">{{reasonLength}} 字</text>
      </view>

      <view class="submit-btn {{canSubmit ? 'ready' : ''}}" bindtap="onSubmit">提交请假申请</view>
      <text class="submit-tip">提交后将发送至您所在代表团组长审批</text>
    </view>
  </view>

  <!-- 记录 -->
  <view class="body" wx:else>
    <view class="record-card" wx:for="{{records}}" wx:key="id">
      <view class="record-top">
        <text class="record-title">{{item.title}}</text>
        <view class="record-status status-{{item.status}}">{{item.statusText}}</view>
      </view>
      <view class="record-row">📅 {{item.date}}</view>
      <view class="record-reason">{{item.reason}}</view>
      <view class="record-row">👤 审批人：{{item.approver}}</view>
    </view>
  </view>
</view>
