<!--pages/leave/leave.wxml-->
<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar">
      <view class="nav-back" bindtap="onBack">‹</view>
      <text class="nav-title">请假申请</text>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <view class="body">
    <view class="form-card">
      <view class="field">
        <text class="field-label">会议名</text>
        <picker mode="selector" range="{{meetingOptions}}" range-key="meetingName" value="{{meetingIndex}}" bindchange="onMeetingChange" disabled="{{!meetingOptions.length}}">
          <view class="picker-row {{meetingIndex < 0 ? 'placeholder' : ''}}">
            <text class="meeting-name-text">{{meetingIndex > -1 ? meetingOptions[meetingIndex].meetingName : '请选择会议'}}</text>
            <view class="select-arrow"></view>
          </view>
        </picker>
      </view>

      <view class="field">
        <text class="field-label">申请人</text>
        <text class="field-value">{{applicant || '—'}}</text>
      </view>

      <view class="field">
        <text class="field-label">请假起始日期</text>
        <picker mode="date" value="{{startDate}}" bindchange="onStartChange">
          <view class="picker-row {{!startDate ? 'placeholder' : ''}}">
            <text>{{startDate || '年 / 月 / 日'}}</text>
            <image class="date-icon" src="/assets/icons/date.png" mode="aspectFit" />
          </view>
        </picker>
      </view>

      <view class="field">
        <text class="field-label">请假结束日期</text>
        <picker mode="date" value="{{endDate}}" bindchange="onEndChange">
          <view class="picker-row {{!endDate ? 'placeholder' : ''}}">
            <text>{{endDate || '年 / 月 / 日'}}</text>
            <image class="date-icon" src="/assets/icons/date.png" mode="aspectFit" />
          </view>
        </picker>
      </view>

      <view class="field field-last">
        <text class="field-label">请假原因</text>
        <textarea
          class="textarea"
          placeholder="请填写请假原因..."
          placeholder-class="ph"
          maxlength="200"
          value="{{reason}}"
          bindinput="onReasonInput"
        />
      </view>
    </view>

    <view class="submit-btn {{canSubmit && !submitting ? 'ready' : ''}}" bindtap="onSubmit">
      <view class="btn-icon"></view>
      <text>{{submitting ? '提交中…' : '提交申请'}}</text>
    </view>
  </view>
</view>
