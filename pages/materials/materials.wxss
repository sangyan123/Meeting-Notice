/* pages/materials/materials.wxss */
.page {
  min-height: 100vh;
  background: var(--bg);
}

.header {
  background: var(--primary);
  padding: 0 32rpx 36rpx;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
}

.nav-placeholder,
.nav-action {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
}

.search-icon {
  font-size: 36rpx;
  filter: brightness(10);
}

.header-info {
  display: flex;
  flex-direction: column;
  margin-top: 8rpx;
}

.meeting-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.material-count {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.filter-bar {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  padding: 24rpx 24rpx 8rpx;
  background: #ffffff;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background: #F0F0F0;
  color: #555555;
  font-size: 26rpx;
  flex-shrink: 0;
}

.filter-chip.active {
  background: var(--primary);
  color: #ffffff;
}

.list {
  margin-top: 16rpx;
  padding-bottom: 32rpx;
}

.agenda-item {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  background: #F3F1EA;
  border-bottom: 1rpx solid #E8E4DA;
}

.agenda-item.open {
  background: #F3F1EA;
}

.agenda-label {
  flex-shrink: 0;
  background: var(--primary);
  color: #ffffff;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.agenda-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.agenda-count {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--text-muted);
  margin: 0 12rpx 0 16rpx;
}

.agenda-arrow {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #AAAAAA;
  transition: transform 0.2s;
}

.agenda-arrow.expanded {
  transform: rotate(180deg);
}

.file-list {
  background: var(--bg);
  padding: 0 24rpx 16rpx;
}

.file-item {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.pdf-badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: 14rpx;
  background: var(--primary);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.file-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.file-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 8rpx;
}

.file-meta {
  font-size: 22rpx;
  color: var(--text-muted);
}

.eye-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #999999;
  flex-shrink: 0;
  margin-left: 8rpx;
  opacity: 0.7;
}
