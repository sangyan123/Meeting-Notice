<!--pages/materials/materials.wxml-->
<view class="page">
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar">
      <view class="nav-placeholder"></view>
      <text class="nav-title">会议材料</text>
      <view class="nav-action" bindtap="onSearch">
        <text class="search-icon">🔍</text>
      </view>
    </view>
    <view class="header-info">
      <text class="meeting-name">{{meetingTitle}}</text>
      <text class="material-count">共 {{totalCount}} 份材料</text>
    </view>
  </view>

  <scroll-view class="filter-bar" scroll-x enable-flex>
    <view
      class="filter-chip {{activeFilter === item.id ? 'active' : ''}}"
      wx:for="{{filters}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onFilter"
    >{{item.name}}</view>
  </scroll-view>

  <view class="list">
    <view class="list-loading" wx:if="{{loading}}">加载中...</view>
    <view class="schedule-box" wx:if="{{showSchedule && scheduleDays.length}}">
      <view class="schedule-day" wx:for="{{scheduleDays}}" wx:for-item="day" wx:key="key">
        <view class="schedule-date">{{day.label}}</view>
        <view class="schedule-item" wx:for="{{day.items}}" wx:for-item="seg" wx:key="dayType">
          <view class="seg-tag">{{seg.tag}}</view>
          <view class="seg-main">
            <text class="seg-title">{{seg.title}}</text>
            <view class="seg-content" wx:for="{{seg.contents}}" wx:for-item="c" wx:key="id">
              <text class="seg-name">{{c.name}}</text>
              <text class="seg-topics" wx:if="{{c.topics}}">议题：{{c.topics}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view class="list-empty" wx:if="{{!loading && groups.length === 0 && !showSchedule}}">该会议暂无材料</view>
    <block wx:for="{{groups}}" wx:key="id">
      <view class="agenda-item {{item.expanded ? 'open' : ''}}" data-id="{{item.id}}" bindtap="onToggle">
        <view class="agenda-label">{{item.index}}</view>
        <text class="agenda-title">{{item.title}}</text>
        <text class="agenda-count">{{item.count}}份</text>
        <text class="agenda-arrow {{item.expanded ? 'expanded' : ''}}">∨</text>
      </view>
      <view class="file-list" wx:if="{{item.expanded}}">
        <view
          class="file-item"
          wx:for="{{item.files}}"
          wx:for-item="file"
          wx:key="id"
          data-id="{{file.id}}"
          bindtap="onPreview"
        >
          <view class="pdf-badge">{{file.type}}</view>
          <view class="file-info">
            <text class="file-title">{{file.title}}</text>
            <text class="file-meta">{{file.meta}}</text>
          </view>
          <view class="eye-btn" catchtap="onPreview" data-id="{{file.id}}">👁</view>
        </view>
      </view>
    </block>
  </view>
</view>
