<!--pages/materials/materials.wxml-->
<view class="page">
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar">
      <view class="nav-placeholder"></view>
      <text class="nav-title">会议材料</text>
      <view class="nav-action" bindtap="onSearch">
        <text class="search-icon">🔍</text>
      </view>
    </view>
    <view class="header-info">
      <text class="meeting-name">{{meetingTitle}}</text>
      <text class="material-count">共 {{totalCount}} 份材料</text>
    </view>
  </view>

  <scroll-view class="filter-bar" scroll-x enable-flex>
    <view
      class="filter-chip {{activeFilter === item.id ? 'active' : ''}}"
      wx:for="{{filters}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onFilter"
    >{{item.name}}</view>
  </scroll-view>

  <view class="list">
    <block wx:for="{{agendas}}" wx:key="id">
      <view class="agenda-item {{item.expanded ? 'open' : ''}}" data-id="{{item.id}}" bindtap="onToggle">
        <view class="agenda-label">议程{{item.index}}</view>
        <text class="agenda-title">{{item.title}}</text>
        <text class="agenda-count">{{item.count}}份</text>
        <text class="agenda-arrow {{item.expanded ? 'expanded' : ''}}">∨</text>
      </view>
      <view class="file-list" wx:if="{{item.expanded}}">
        <view
          class="file-item"
          wx:for="{{item.files}}"
          wx:for-item="file"
          wx:key="id"
          data-id="{{file.id}}"
          bindtap="onPreview"
        >
          <view class="pdf-badge">PDF</view>
          <view class="file-info">
            <text class="file-title">{{file.title}}</text>
            <text class="file-meta">{{file.pages}} 页 · {{file.size}}</text>
          </view>
          <view class="eye-btn" catchtap="onPreview" data-id="{{file.id}}">👁</view>
        </view>
      </view>
    </block>
  </view>
</view>
