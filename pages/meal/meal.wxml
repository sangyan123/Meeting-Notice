<!--pages/meal/meal.wxml-->
<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar">
      <view class="nav-back" bindtap="onBack">‹</view>
      <text class="nav-title">用餐安排</text>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <scroll-view class="body" scroll-y>
    <view class="meal-card" wx:for="{{meals}}" wx:key="id">
      <view class="meal-head">
        <view class="meal-icon {{item.highlight ? 'yellow' : ''}}">🍴</view>
        <view class="meal-title-wrap">
          <text class="meal-name">{{item.name}}</text>
          <text class="meal-time">{{item.time}}</text>
        </view>
      </view>
      <view class="meal-row">
        <text class="meal-label">就餐地点</text>
        <text class="meal-value">{{item.place}}</text>
      </view>
      <view class="meal-row">
        <text class="meal-label">备注</text>
        <text class="meal-value">{{item.note}}</text>
      </view>
    </view>

    <view class="tips-box">
      <text class="tips-title">用餐温馨提示</text>
      <text class="tips-content">用餐时请出示代表证，遵守会场秩序。如有特殊饮食需求（素食、清真等），请提前联系会务组。</text>
    </view>
  </scroll-view>
</view>
