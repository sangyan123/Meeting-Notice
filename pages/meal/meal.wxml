<!--pages/meal/meal.wxml-->
<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar">
      <view class="nav-back" bindtap="onBack">‹</view>
      <text class="nav-title">用餐安排</text>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <scroll-view class="body" scroll-y>
    <view class="loading" wx:if="{{loading}}">加载中...</view>

    <block wx:if="{{!loading}}">
      <view class="meal-group" wx:for="{{groups}}" wx:for-item="group" wx:key="meetingId">
        <view class="group-meeting">{{group.meetingName}}</view>

        <view class="diet-tip" wx:if="{{group.dietReminder}}">
          <text class="diet-icon">!</text>
          <text class="diet-text">{{group.dietReminder}}</text>
        </view>

        <view class="meal-card" wx:for="{{group.meals}}" wx:key="id">
          <view class="meal-head">
            <view class="meal-icon"><image class="meal-icon-img" src="/assets/icons/svc-meal.png" mode="aspectFit" /></view>
            <view class="meal-title-wrap">
              <text class="meal-name">{{item.name}}</text>
              <text class="meal-time">{{item.time}}</text>
            </view>
          </view>
          <view class="meal-row">
            <text class="meal-label">就餐地点</text>
            <text class="meal-value">{{item.place}}</text>
          </view>
          <view class="meal-row" wx:if="{{item.note}}">
            <text class="meal-label">备注</text>
            <text class="meal-value">{{item.note}}</text>
          </view>
        </view>
      </view>

      <view class="empty" wx:if="{{totalMeals === 0}}">
        <text class="empty-title">暂无用餐安排</text>
        <text class="empty-desc">会议用餐安排确定后将在此展示</text>
      </view>

      <view class="tips-box">
        <text class="tips-title">用餐温馨提示</text>
        <text class="tips-content">用餐时请出示代表证，遵守会场秩序。如有特殊饮食需求（素食、清真等），请提前联系会务组。</text>
      </view>
    </block>
  </scroll-view>
</view>
