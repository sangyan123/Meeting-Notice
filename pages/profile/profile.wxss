/* pages/profile/profile.wxss */
.page {
  min-height: 100vh;
  background: var(--bg);
}

.header {
  position: relative;
  overflow: hidden;
  background-color: #155FE6;
  padding: 24rpx 40rpx 56rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.user-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  border: 4rpx solid rgba(255, 255, 255, 0.48);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 28rpx;
}

.avatar-text {
  font-size: 46rpx;
  color: #ffffff;
  font-weight: 600;
}

.user-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.user-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.user-meta {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.86);
  line-height: 1.55;
}

.body {
  margin-top: -24rpx;
  padding: 0 24rpx 48rpx;
  position: relative;
  z-index: 1;
}

.info-card {
  margin: 0;
  padding: 6rpx 28rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
  margin-right: 24rpx;
}

.info-value {
  font-size: 26rpx;
  color: var(--text);
  font-weight: 500;
  text-align: right;
  flex: 1;
}

.group-label {
  margin: 30rpx 8rpx 16rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.menu-card {
  margin: 0;
  padding: 0 8rpx 0 24rpx;
}

.record-list {
  display: block;
}

.record-item {
  margin-bottom: 16rpx;
}

.record-item:last-child {
  margin-bottom: 0;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 20rpx 28rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-img {
  width: 52rpx;
  height: 52rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.menu-label {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: var(--text);
}

.logout-btn {
  margin-top: 34rpx;
  background: #ffffff;
  border-radius: 20rpx;
  height: 94rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--text-secondary);
  box-shadow: 0 6rpx 20rpx rgba(31, 66, 135, 0.06);
}
