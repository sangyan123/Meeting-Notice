<!--pages/meeting-detail/meeting-detail.wxml-->
<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar">
      <view class="nav-back" bindtap="onBack">‹</view>
      <text class="nav-title">会议详情</text>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <view class="loading" wx:if="{{loading}}">加载中...</view>

  <block wx:if="{{!loading && meeting}}">
    <!-- 基本信息 -->
    <view class="hero-card">
      <view class="hero-title-row">
        <text class="hero-title">{{meeting.title}}</text>
        <text class="type-tag" wx:if="{{meeting.type}}">{{meeting.type}}</text>
      </view>
      <view class="meta-list">
        <view class="meta-row">
          <image class="meta-icon" src="/assets/icons/date.png" mode="aspectFit" />
          <text class="meta-label">会议时间</text>
          <text class="meta-value">{{meeting.time}}</text>
        </view>
        <view class="meta-row">
          <image class="meta-icon" src="/assets/icons/meta-location.png" mode="aspectFit" />
          <text class="meta-label">会议地点</text>
          <text class="meta-value">{{meeting.location}}</text>
        </view>
      </view>
      <view class="stats-row">
        <view class="stat" wx:for="{{stats}}" wx:key="id">
          <text class="stat-num">{{item.value}}</text>
          <text class="stat-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- 资料分类 -->
    <view class="section" wx:if="{{tabs.length > 0}}">
      <view class="section-title">资料分类</view>
      <view class="tab-chips">
        <view class="tab-chip" wx:for="{{tabs}}" wx:key="id">{{item.name}}</view>
      </view>
    </view>

    <!-- 参会人员 -->
    <view class="section" wx:if="{{persons.length > 0}}">
      <view class="section-title">参会人员</view>
      <view class="card">
        <view class="person-row" wx:for="{{persons}}" wx:key="id">
          <view class="avatar">{{item.avatarText}}</view>
          <view class="person-main">
            <text class="person-name">{{item.name}}</text>
            <text class="person-sub" wx:if="{{item.unit || item.position}}">{{item.unit}}{{item.position ? ' · ' + item.position : ''}}</text>
          </view>
          <view class="person-right" wx:if="{{item.seat || item.group}}">
            <text class="person-seat" wx:if="{{item.seat}}">{{item.seat}}</text>
            <text class="person-group" wx:if="{{item.group}}">{{item.group}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{tabs.length === 0 && persons.length === 0}}">暂无更多会议信息</view>
  </block>

  <view class="safe-bottom"></view>
</view>
