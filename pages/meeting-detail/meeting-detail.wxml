<!--pages/meeting-detail/meeting-detail.wxml-->
<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar">
      <view class="nav-back" bindtap="onBack">‹</view>
      <text class="nav-title">会议详情</text>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <view class="loading" wx:if="{{loading}}">加载中...</view>

  <block wx:if="{{!loading && meeting}}">
    <!-- 蓝色头图：状态 + 标题 + 时间地点 -->
    <view class="hero">
      <view class="status-pill status-{{meeting.statusType}}" wx:if="{{meeting.statusText}}">{{meeting.statusText}}</view>
      <text class="hero-title">{{meeting.title}}</text>
      <view class="hero-meta">
        <view class="meta-icon meta-icon-date"></view>
        <text class="hero-meta-text">{{meeting.dateText}} {{meeting.timeText}}</text>
      </view>
      <view class="hero-meta">
        <view class="meta-icon meta-icon-location"></view>
        <text class="hero-meta-text">{{meeting.location}}</text>
      </view>
    </view>

    <!-- 议题 -->
    <view class="section" wx:if="{{topics.length > 0}}">
      <text class="section-label">议题</text>
      <view class="topic-card">
        <view class="topic-row" wx:for="{{topics}}" wx:key="id">
          <view class="topic-index">{{index + 1}}</view>
          <text class="topic-name">{{item.name}}</text>
        </view>
      </view>
    </view>

    <!-- 会议信息 -->
    <view class="section">
      <text class="section-label">会议信息</text>
      <view class="info-card">
        <view class="info-row">
          <text class="info-label">会议名称</text>
          <text class="info-value">{{meeting.title}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">会议日期</text>
          <text class="info-value">{{meeting.dateText}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">会议时间</text>
          <text class="info-value">{{meeting.timeText}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">会议地点</text>
          <text class="info-value">{{meeting.location}}</text>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{topics.length === 0}}">暂无议题信息</view>
  </block>

  <view class="safe-bottom"></view>
</view>
