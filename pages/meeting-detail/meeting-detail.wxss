/* pages/meeting-detail/meeting-detail.wxss */
.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.nav-bar {
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: var(--text);
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
}

.nav-placeholder {
  width: 64rpx;
}

.loading {
  padding: 120rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-muted);
}

.hero-card {
  margin: 20rpx 32rpx 0;
  padding: 36rpx 32rpx;
  background: var(--card);
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.hero-title-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.hero-title {
  flex: 1;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.4;
}

.type-tag {
  flex-shrink: 0;
  margin-top: 4rpx;
  padding: 6rpx 16rpx;
  background: #FDECED;
  color: var(--primary);
  font-size: 22rpx;
  border-radius: 8rpx;
}

.meta-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.meta-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.meta-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.meta-value {
  font-size: 26rpx;
  color: var(--text);
}

.stats-row {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--border);
  display: flex;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary);
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.section {
  margin: 32rpx 32rpx 0;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 20rpx;
}

.section-title::before {
  content: '';
  width: 8rpx;
  height: 28rpx;
  background: var(--primary);
  border-radius: 4rpx;
  margin-right: 14rpx;
}

.tab-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tab-chip {
  padding: 12rpx 28rpx;
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--text);
}

.card {
  background: var(--card);
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.person-row {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--border);
}

.person-row:last-child {
  border-bottom: none;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.person-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.person-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.person-sub {
  font-size: 24rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.person-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.person-seat {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 600;
}

.person-group {
  font-size: 22rpx;
  color: var(--text-muted);
}

.empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-muted);
}

.safe-bottom {
  height: env(safe-area-inset-bottom);
}
