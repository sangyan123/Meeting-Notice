/* pages/notices/notices.wxss */
.page {
  min-height: 100vh;
  background: var(--bg);
}

.nav {
  background: var(--primary);
}

.nav-bar {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-back,
.nav-placeholder {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 56rpx;
  font-weight: 300;
  line-height: 1;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
}

.filter-bar {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  padding: 24rpx 24rpx 8rpx;
  background: #ffffff;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background: #F0F0F0;
  color: #555555;
  font-size: 26rpx;
  flex-shrink: 0;
}

.filter-chip.active {
  background: var(--primary);
  color: #ffffff;
}

.list {
  padding: 24rpx;
}

.notice-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.notice-body {
  flex: 1;
  min-width: 0;
}

.title-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
}

.unread-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--primary);
  margin-top: 14rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.unread-placeholder {
  width: 12rpx;
  height: 12rpx;
  margin-top: 14rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  visibility: hidden;
}

.notice-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.4;
}

.meta-row {
  display: flex;
  align-items: center;
  padding-left: 24rpx;
  gap: 16rpx;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.tag-pre {
  background: #E8F3FC;
  color: #3A8FD6;
}

.tag-mid {
  background: #FDECED;
  color: #C82439;
}

.tag-post {
  background: #F5F0E6;
  color: #A67C52;
}

.notice-time {
  font-size: 22rpx;
  color: var(--text-muted);
}

.chevron {
  color: #CCCCCC;
  font-size: 32rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.empty {
  text-align: center;
  color: var(--text-muted);
  font-size: 26rpx;
  padding: 80rpx 0;
}
