<!--pages/notices/notices.wxml-->
<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar">
      <view class="nav-back" bindtap="onBack">‹</view>
      <text class="nav-title">消息通知</text>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <scroll-view class="filter-bar" scroll-x enable-flex>
    <view
      class="filter-chip {{activeFilter === item.id ? 'active' : ''}}"
      wx:for="{{filters}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onFilter"
    >{{item.name}}</view>
  </scroll-view>

  <view class="list">
    <view
      class="notice-card"
      wx:for="{{filteredList}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onNoticeTap"
    >
      <view class="notice-body">
        <view class="title-row">
          <view class="unread-dot" wx:if="{{item.unread}}"></view>
          <view class="unread-placeholder" wx:else></view>
          <text class="notice-title">{{item.title}}</text>
        </view>
        <view class="meta-row">
          <text class="tag tag-{{item.tagType}}">{{item.tag}}</text>
          <text class="notice-time">{{item.datetime}}</text>
        </view>
        <view class="sub-row" wx:if="{{item.meetingName}}">
          <text class="notice-meeting">{{item.meetingName}}</text>
          <text class="receipt-badge {{item.myReceiptType}}" wx:if="{{item.requireReceipt && item.myReceiptType}}">{{item.myReceiptType === 'attend' ? '已回执：出席' : '已回执：请假'}}</text>
        </view>
      </view>
      <text class="chevron">›</text>
    </view>
    <view class="empty" wx:if="{{!loading && filteredList.length === 0}}">暂无相关通知</view>
    <view class="load-tip" wx:if="{{loading || loadingMore}}">加载中...</view>
    <view class="load-tip" wx:if="{{!loading && !loadingMore && filteredList.length > 0 && finished}}">没有更多了</view>
  </view>
</view>
