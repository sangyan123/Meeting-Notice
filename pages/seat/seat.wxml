<!--pages/seat/seat.wxml-->
<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar">
      <view class="nav-back" bindtap="onBack">‹</view>
      <text class="nav-title">电子排座</text>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <view class="body">
    <view class="card">
      <view class="seat-head">
        <text class="card-title">我的座位</text>
        <view class="seat-badge">{{seatInfo.seat}}</view>
      </view>
      <view class="row">
        <text class="row-label">分组</text>
        <text class="row-value">{{seatInfo.group}}</text>
      </view>
      <view class="row" wx:if="{{tableCard}}">
        <text class="row-label">桌牌</text>
        <text class="row-value">{{tableCard}}</text>
      </view>
      <view class="row">
        <text class="row-label">会议地点</text>
        <text class="row-value">{{seatInfo.place}}</text>
      </view>
    </view>

    <view class="card">
      <text class="card-title">会议信息</text>
      <view class="row">
        <text class="row-label">会议名称</text>
        <text class="row-value">{{meetingName}}</text>
      </view>
      <view class="row">
        <text class="row-label">会议时间</text>
        <text class="row-value">{{meetingTime}}</text>
      </view>
    </view>

    <view class="card" wx:if="{{hasMap}}">
      <text class="card-title">座位图{{mapName ? ' · ' + mapName : ''}}</text>
      <view class="map">
        <view class="stage">主席台</view>
        <scroll-view class="seat-scroll" scroll-x>
          <view class="seat-row" wx:for="{{mapRows}}" wx:for-item="row" wx:key="idx">
            <view
              class="seat {{cell.mine ? 'mine' : ''}} {{cell.disabled ? 'disabled' : ''}} {{cell.blank || cell.aisle ? 'ghost' : ''}}"
              wx:for="{{row.cells}}"
              wx:for-item="cell"
              wx:key="id"
            >
              <text wx:if="{{cell.mine}}">我</text>
              <text wx:elif="{{cell.name}}">{{cell.name}}</text>
            </view>
          </view>
        </scroll-view>
        <view class="legend">
          <view class="legend-dot"></view>
          <text class="legend-text">红色为您的座位{{myMapSeat ? '（' + myMapSeat + '）' : ''}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
