@import "../../styles/service-page.wxss";

.seat-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.seat-head .card-title {
  margin-bottom: 0;
}

.seat-badge {
  background: var(--primary);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 28rpx;
}

.map {
  margin-top: 24rpx;
  background: #FAFAF7;
  border-radius: 16rpx;
  padding: 28rpx 24rpx 20rpx;
}

.stage {
  background: var(--primary);
  color: #ffffff;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  padding: 22rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.zones-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.zones-row.bottom .zone.wide {
  flex: 1;
  height: 120rpx;
}

.zone {
  flex: 1;
  height: 140rpx;
  background: #FDE8EA;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.zone-name {
  font-size: 28rpx;
  color: #C82439;
  font-weight: 600;
}

.me-mark {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #F5C518;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(245, 197, 24, 0.45);
}

.legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 8rpx;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #F5C518;
  margin-right: 10rpx;
}

.legend-text {
  font-size: 22rpx;
  color: var(--text-secondary);
}
