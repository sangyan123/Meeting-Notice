@import "../../styles/service-page.wxss";

/* ---- 顶部导航 ---- */
.nav {
  background: var(--primary);
}

.nav-bar {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-back,
.nav-placeholder {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 40rpx;
  height: 40rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
}

/* ---- 页面主体 ---- */
.body {
  padding: 24rpx;
}

.warn-banner {
  display: flex;
  align-items: center;
  background: #FFF8E6;
  color: #8A7A4A;
  font-size: 24rpx;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

/* ---- 单张表单卡片 ---- */
.form-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 12rpx 32rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 66, 135, 0.06);
}

.field {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F0F3F8;
}

.field:last-child {
  border-bottom: none;
}

.field-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 14rpx;
}

.field-value {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.4;
}

/* ---- 日期选择行 ---- */
.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.picker-row.placeholder {
  color: #B9C2CE;
  font-weight: 400;
}

.date-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

/* ---- 交通方式胶囊按钮 ---- */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 12rpx 36rpx;
  border: 1rpx solid #D8DFE8;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: var(--text);
  background: #ffffff;
  transition: all 0.15s ease;
}

.chip.active {
  background: var(--primary-light);
  border-color: var(--primary);
  color: var(--primary);
  font-weight: 600;
}

/* ---- 住宿开关行 ---- */
.switch-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.switch-field .field-label {
  margin-bottom: 0;
}

.hotel-switch {
  transform: scale(0.9);
}

/* ---- 提交按钮 ---- */
.submitted-tip {
  font-size: 24rpx;
  color: var(--text-muted);
  text-align: center;
  margin: 16rpx 0;
}

.submit-btn {
  margin-top: 32rpx;
  height: 92rpx;
  border-radius: 20rpx;
  background: #C8C4BB;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s ease;
}

.submit-btn.ready {
  background: var(--primary);
}

/* 纸飞机图标（内嵌 SVG） */
.btn-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  background-color: #ffffff;
  -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M2.01 21L23 12 2.01 3 2 10l15 2-15 2z'/></svg>");
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
  mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M2.01 21L23 12 2.01 3 2 10l15 2-15 2z'/></svg>");
  mask-repeat: no-repeat;
  mask-position: center;
  mask-size: contain;
}
