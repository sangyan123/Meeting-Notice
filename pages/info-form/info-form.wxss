@import "../../styles/service-page.wxss";

.section-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary);
  margin-bottom: 20rpx;
}

.section-title.muted {
  color: var(--text-secondary);
}

.field {
  margin-bottom: 24rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.dropdown-field {
  position: relative;
  z-index: 20;
  overflow: visible;
}

.field-label {
  display: block;
  font-size: 26rpx;
  color: var(--text);
  margin-bottom: 12rpx;
}

.req {
  color: var(--primary);
}

.input {
  border: 1rpx solid #E5E5E5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  background: #FAFAFA;
}

.input.readonly {
  color: #666666;
  background: #F3F1EA;
}

.dropdown {
  position: relative;
  z-index: 30;
}

.dropdown-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid #E5E5E5;
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
  font-size: 26rpx;
  color: var(--text);
  background: #ffffff;
}

.dropdown-trigger.placeholder {
  color: #AAAAAA;
}

.dropdown-trigger.open {
  border-color: var(--primary);
}

.dropdown-panel {
  position: absolute;
  left: 0;
  right: 0;
  top: calc(100% + 4rpx);
  background: #ffffff;
  border: 1rpx solid #D0D0D0;
  border-radius: 4rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  z-index: 40;
  overflow: hidden;
}

.dropdown-item {
  padding: 22rpx 24rpx;
  font-size: 26rpx;
  color: #666666;
  border-bottom: 1rpx solid #F0EEE8;
}

.dropdown-item:last-child {
  border-bottom: none;
}

.dropdown-item.active {
  background: #666666;
  color: #ffffff;
}

.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid #E5E5E5;
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
  font-size: 26rpx;
  color: var(--text);
  background: #FAFAFA;
}

.picker.placeholder {
  color: #AAAAAA;
}

.arrow {
  color: #CCCCCC;
  font-size: 22rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.radio-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--text);
}

.radio-item radio {
  margin-right: 12rpx;
  transform: scale(0.9);
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  border: 1rpx solid #E5E5E5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  background: #FAFAFA;
  box-sizing: border-box;
}

.submit-btn {
  margin: 8rpx 0 48rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: #C8C4BB;
  color: #ffffff;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn.ready {
  background: var(--primary);
}

.travel-card {
  overflow: visible;
  position: relative;
  z-index: 10;
}
