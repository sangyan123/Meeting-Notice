<!--pages/info-form/info-form.wxml-->
<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar">
      <view class="nav-back" bindtap="onBack">‹</view>
      <text class="nav-title">参会信息填报</text>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <view class="body">
    <view class="warn-banner" wx:if="{{banner}}">{{banner}}</view>

    <view class="form-card">
      <view class="field">
        <text class="field-label">会议名</text>
        <picker mode="selector" range="{{meetingOptions}}" range-key="meetingName" value="{{meetingIndex}}" bindchange="onMeetingChange" disabled="{{!meetingOptions.length}}">
          <view class="picker-row {{meetingIndex < 0 ? 'placeholder' : ''}}">
            <text class="meeting-name-text">{{meetingIndex > -1 ? meetingOptions[meetingIndex].meetingName : '请选择会议'}}</text>
            <view class="select-arrow"></view>
          </view>
        </picker>
      </view>

      <view class="field">
        <text class="field-label">姓名</text>
        <text class="field-value">{{form.name || '—'}}</text>
      </view>

      <view class="field">
        <text class="field-label">代表团</text>
        <text class="field-value">{{form.delegation || '—'}}</text>
      </view>

      <view class="field">
        <text class="field-label">抵达日期</text>
        <picker mode="date" value="{{form.arriveDate}}" bindchange="onArrive">
          <view class="picker-row {{!form.arriveDate ? 'placeholder' : ''}}">
            <text>{{form.arriveDate || '年 / 月 / 日'}}</text>
            <image class="date-icon" src="/assets/icons/date.png" mode="aspectFit" />
          </view>
        </picker>
      </view>

      <view class="field">
        <text class="field-label">离开日期</text>
        <picker mode="date" value="{{form.leaveDate}}" bindchange="onLeaveDate">
          <view class="picker-row {{!form.leaveDate ? 'placeholder' : ''}}">
            <text>{{form.leaveDate || '年 / 月 / 日'}}</text>
            <image class="date-icon" src="/assets/icons/date.png" mode="aspectFit" />
          </view>
        </picker>
      </view>

      <view class="field">
        <text class="field-label">交通方式</text>
        <view class="chips">
          <view
            class="chip {{form.transport === item.value ? 'active' : ''}}"
            wx:for="{{transportOptions}}"
            wx:key="value"
            data-value="{{item.value}}"
            bindtap="onSelectTransport"
          >{{item.label}}</view>
        </view>
      </view>

      <view class="field switch-field">
        <text class="field-label">需要住宿安排</text>
        <switch class="hotel-switch" checked="{{form.hotelNeed === 'yes'}}" bindchange="onHotelToggle" color="#1A6DFF" />
      </view>
    </view>

    <view class="submitted-tip" wx:if="{{submitted}}">您已提交过，本次提交将覆盖之前的填报内容</view>

    <view class="submit-btn {{canSubmit && hasMeeting && !submitting ? 'ready' : ''}}" bindtap="onSubmit">
      <view class="btn-icon"></view>
      <text>{{submitting ? '提交中…' : '提交信息'}}</text>
    </view>
  </view>
</view>
