<!--pages/guide/guide.wxml-->
<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar">
      <view class="nav-back" bindtap="onBack">‹</view>
      <text class="nav-title">会议指南</text>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <view class="body">
    <view class="section" wx:for="{{sections}}" wx:key="id" wx:for-item="section">
      <view class="section-title">{{section.title}}</view>
      <view class="card">
        <view class="item" wx:for="{{section.items}}" wx:key="*this" wx:for-item="item">
          <view class="dot"></view>
          <text class="text">{{item}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
