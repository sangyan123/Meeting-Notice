<!--pages/message-setting/message-setting.wxml-->
<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar">
      <view class="nav-back" bindtap="onBack">‹</view>
      <text class="nav-title">消息设置</text>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <view class="body">
    <view class="card">
      <view class="setting-row" wx:for="{{options}}" wx:key="id">
        <view class="setting-info">
          <text class="setting-name">{{item.name}}</text>
          <text class="setting-desc">{{item.desc}}</text>
        </view>
        <switch
          checked="{{settings[item.id]}}"
          color="#1A6DFF"
          data-id="{{item.id}}"
          bindchange="onToggle"
        />
      </view>
    </view>
    <view class="safe-bottom"></view>
  </view>
</view>
