<!--pages/bus/bus.wxml-->
<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar">
      <view class="nav-back" bindtap="onBack">‹</view>
      <text class="nav-title">班车安排</text>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <view class="body">
    <view class="alert">
      <text class="alert-icon">ⓘ</text>
      <text class="alert-text">每日发车时间如有调整，将通过消息通知提前告知，请及时查阅。</text>
    </view>

    <view class="loading" wx:if="{{loading}}">加载中...</view>

    <block wx:if="{{!loading}}">
      <view class="bus-group" wx:for="{{groups}}" wx:for-item="group" wx:key="meetingId">
        <view class="group-meeting">{{group.meetingName}}</view>

        <view class="bus-card {{bus.stopped ? 'stopped' : ''}}" wx:for="{{group.buses}}" wx:for-item="bus" wx:key="id">
          <view class="bus-top">
            <view class="bus-left">
              <image class="bus-icon" src="/assets/icons/che.png" mode="aspectFit" />
              <text class="bus-no">{{bus.no}}</text>
              <text class="bus-time">{{bus.time}}</text>
              <text class="bus-date" wx:if="{{bus.date}}">{{bus.date}}</text>
            </view>
            <view class="status {{bus.stopped ? 'stopped' : bus.full ? 'full' : 'ok'}}">{{bus.stopped ? '停运' : bus.full ? '已满员' : '可乘坐'}}</view>
          </view>
          <view class="bus-route"><image class="route-icon" src="/assets/icons/meta-location.png" mode="aspectFit" /><text>{{bus.route}}</text></view>
          <view class="bus-bottom">
            <view class="progress">
              <view
                class="progress-bar {{bus.full ? 'full' : ''}}"
                style="width: {{bus.percent}}%;"
              ></view>
            </view>
            <text class="cap">{{bus.current}}/{{bus.capacity}}</text>
          </view>
          <view class="bus-remark" wx:if="{{bus.remark}}">{{bus.remark}}</view>
          <view class="bus-actions">
            <view
              wx:if="{{bus.myBooked}}"
              class="book-btn booked"
              data-id="{{bus.id}}"
              bindtap="onCancelBookTap"
            >已预约 · 点击取消</view>
            <view
              wx:elif="{{bus.bookable}}"
              class="book-btn ready {{booking ? 'disabled' : ''}}"
              data-id="{{bus.id}}"
              bindtap="onBookTap"
            >预约乘车</view>
            <view wx:else class="book-btn disabled">{{bus.stopped ? '该班次已停运' : '名额已满'}}</view>
          </view>
        </view>
      </view>

      <view class="empty" wx:if="{{!groups.length}}">
        <text class="empty-title">暂无班车安排</text>
        <text class="empty-desc">班车班次确定后将在此展示</text>
      </view>
    </block>
  </view>
</view>
