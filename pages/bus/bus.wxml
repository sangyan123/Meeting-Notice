<!--pages/bus/bus.wxml-->
<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar">
      <view class="nav-back" bindtap="onBack">‹</view>
      <text class="nav-title">班车安排</text>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <view class="body">
    <view class="alert">
      <text class="alert-icon">ⓘ</text>
      <text class="alert-text">每日发车时间如有调整，将通过消息通知提前告知，请及时查阅。</text>
    </view>

    <view class="bus-card" wx:for="{{buses}}" wx:key="id">
      <view class="bus-top">
        <view class="bus-left">
          <text class="bus-icon">🚌</text>
          <text class="bus-no">班次{{item.no}}</text>
          <text class="bus-time">{{item.time}}</text>
        </view>
        <view class="status {{item.full ? 'full' : 'ok'}}">{{item.full ? '已满员' : '可乘坐'}}</view>
      </view>
      <view class="bus-route">📍 {{item.route}}</view>
      <view class="bus-bottom">
        <view class="progress">
          <view
            class="progress-bar {{item.full ? 'full' : ''}}"
            style="width: {{item.percent}}%;"
          ></view>
        </view>
        <text class="cap">{{item.current}}/{{item.capacity}}</text>
      </view>
    </view>
  </view>
</view>
