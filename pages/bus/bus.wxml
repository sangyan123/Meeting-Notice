<!--pages/bus/bus.wxml-->
<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar">
      <view class="nav-back" bindtap="onBack">‹</view>
      <text class="nav-title">班车安排</text>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <view class="body">
    <view class="alert">
      <text class="alert-icon">ⓘ</text>
      <text class="alert-text">每日发车时间如有调整，将通过消息通知提前告知，请及时查阅。</text>
    </view>

    <view class="loading" wx:if="{{loading}}">加载中...</view>

    <block wx:if="{{!loading}}">
      <view class="bus-card {{item.stopped ? 'stopped' : ''}}" wx:for="{{buses}}" wx:key="id">
        <view class="bus-top">
          <view class="bus-left">
            <image class="bus-icon" src="/assets/icons/che.png" mode="aspectFit" />
            <text class="bus-no">{{item.no}}</text>
            <text class="bus-time">{{item.time}}</text>
            <text class="bus-date" wx:if="{{item.date}}">{{item.date}}</text>
          </view>
          <view class="status {{item.stopped ? 'stopped' : item.full ? 'full' : 'ok'}}">{{item.stopped ? '停运' : item.full ? '已满员' : '可乘坐'}}</view>
        </view>
        <view class="bus-route"><image class="route-icon" src="/assets/icons/meta-location.png" mode="aspectFit" /><text>{{item.route}}</text></view>
        <view class="bus-bottom">
          <view class="progress">
            <view
              class="progress-bar {{item.full ? 'full' : ''}}"
              style="width: {{item.percent}}%;"
            ></view>
          </view>
          <text class="cap">{{item.current}}/{{item.capacity}}</text>
        </view>
        <view class="bus-remark" wx:if="{{item.remark}}">{{item.remark}}</view>
        <view class="bus-actions">
          <view
            wx:if="{{item.myBooked}}"
            class="book-btn booked"
            data-id="{{item.id}}"
            bindtap="onCancelBookTap"
          >已预约 · 点击取消</view>
          <view
            wx:elif="{{item.bookable}}"
            class="book-btn ready {{booking ? 'disabled' : ''}}"
            data-id="{{item.id}}"
            bindtap="onBookTap"
          >预约乘车</view>
          <view wx:else class="book-btn disabled">{{item.stopped ? '该班次已停运' : '名额已满'}}</view>
        </view>
      </view>

      <view class="empty" wx:if="{{buses.length === 0}}">
        <text class="empty-title">暂无班车安排</text>
        <text class="empty-desc">班车班次确定后将在此展示</text>
      </view>
    </block>
  </view>
</view>
