@import "../../styles/service-page.wxss";

.alert {
  display: flex;
  align-items: flex-start;
  background: #E8F3FC;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.alert-icon {
  color: #3A8FD6;
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.alert-text {
  flex: 1;
  font-size: 24rpx;
  color: #3A8FD6;
  line-height: 1.5;
}

.bus-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.bus-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.bus-left {
  display: flex;
  align-items: center;
}

.bus-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.bus-no {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-right: 16rpx;
}

.bus-time {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary);
}

.status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.status.ok {
  background: #E8F7EF;
  color: #3DAA6D;
}

.status.full {
  background: #EAF2FF;
  color: #1A6DFF;
}

.status.stopped {
  background: #F0F0F0;
  color: #999999;
}

.bus-date {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-left: 16rpx;
}

.bus-route {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 20rpx;
}

.bus-bottom {
  display: flex;
  align-items: center;
}

.progress {
  flex: 1;
  height: 12rpx;
  background: #F0EEE8;
  border-radius: 6rpx;
  overflow: hidden;
  margin-right: 16rpx;
}

.progress-bar {
  height: 100%;
  background: #3A8FD6;
  border-radius: 6rpx;
}

.progress-bar.full {
  background: var(--primary);
}

.cap {
  font-size: 22rpx;
  color: var(--text-muted);
  flex-shrink: 0;
}


.route-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.bus-remark {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 12rpx;
  line-height: 1.5;
}

.bus-actions {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0EEE8;
  display: flex;
  justify-content: flex-end;
}

.book-btn {
  font-size: 26rpx;
  padding: 14rpx 44rpx;
  border-radius: 36rpx;
  text-align: center;
}

.book-btn.ready {
  background: var(--primary);
  color: #ffffff;
}

.book-btn.booked {
  background: #E8F7EF;
  color: #3DAA6D;
  border: 1rpx solid #BFE6CF;
  box-sizing: border-box;
}

.book-btn.disabled {
  background: #F0EEE8;
  color: var(--text-muted);
}

.loading {
  text-align: center;
  color: var(--text-muted);
  font-size: 26rpx;
  padding: 120rpx 0;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: var(--text-muted);
  text-align: center;
}

.bus-card.stopped {
  opacity: 0.65;
}
