@import "../../styles/service-page.wxss";

.record-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.record-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.record-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.4;
  margin-right: 16rpx;
}

.record-status {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.record-status.attend {
  background: #E8F7EF;
  color: #3DAA6D;
}

.record-status.leave {
  background: #FFF6E5;
  color: #C9A227;
}

.record-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.tag-pre {
  background: #E8F3FC;
  color: #3A8FD6;
}

.tag-mid {
  background: #EAF2FF;
  color: #1A6DFF;
}

.tag-post {
  background: #F5F0E6;
  color: #A67C52;
}

.record-meeting {
  font-size: 22rpx;
  color: var(--text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-reason {
  font-size: 26rpx;
  color: #555555;
  line-height: 1.5;
  margin-bottom: 10rpx;
}

.record-time {
  font-size: 22rpx;
  color: var(--text-muted);
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 40rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: var(--text-muted);
  text-align: center;
}

.load-tip {
  text-align: center;
  color: var(--text-muted);
  font-size: 24rpx;
  padding: 24rpx 0 40rpx;
}

/* ==================== 回执详情弹窗 ==================== */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  animation: mask-in 0.2s ease-out;
}

.popup-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 20rpx 36rpx calc(48rpx + env(safe-area-inset-bottom));
  z-index: 1001;
  animation: sheet-up 0.25s ease-out;
}

@keyframes mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes sheet-up {
  from { transform: translateY(40%); opacity: 0.6; }
  to { transform: translateY(0); opacity: 1; }
}

.popup-handle {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #E4E7EE;
  margin: 0 auto 28rpx;
}

.popup-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 10rpx;
}

.popup-subtitle {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 28rpx;
}

.popup-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}

.popup-label {
  font-size: 26rpx;
  color: #8A94A6;
}

.popup-value {
  font-size: 26rpx;
  color: var(--text);
}

.popup-value.status.attend {
  color: #3DAA6D;
  font-weight: 600;
}

.popup-value.status.leave {
  color: #E8833A;
  font-weight: 600;
}
