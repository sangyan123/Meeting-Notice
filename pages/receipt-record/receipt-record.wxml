<!--pages/receipt-record/receipt-record.wxml-->
<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar">
      <view class="nav-back" bindtap="onBack">‹</view>
      <text class="nav-title">回执记录</text>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <view class="body">
    <view
      class="record-card"
      wx:for="{{list}}"
      wx:key="id"
      data-index="{{index}}"
      bindtap="onItemTap"
    >
      <view class="record-top">
        <text class="record-title">{{item.title}}</text>
        <view class="record-status {{item.isLeave ? 'leave' : 'attend'}}">{{item.receiptText}}</view>
      </view>
      <view class="record-meta">
        <text class="tag tag-{{item.tagType}}">{{item.tag}}</text>
        <text class="record-meeting" wx:if="{{item.meetingName}}">{{item.meetingName}}</text>
      </view>
      <view class="record-reason" wx:if="{{item.isLeave && item.reason}}">请假原因：{{item.reason}}</view>
      <view class="record-time">提交时间：{{item.submitTime}}</view>
    </view>

    <view class="empty" wx:if="{{!loading && list.length === 0}}">
      <text class="empty-title">暂无回执记录</text>
      <text class="empty-desc">对要求回执的通知提交「出席/请假」后，记录会显示在这里</text>
    </view>
    <view class="load-tip" wx:if="{{loading || loadingMore}}">加载中...</view>
    <view class="load-tip" wx:if="{{!loading && !loadingMore && list.length > 0 && finished}}">没有更多了</view>
  </view>

  <!-- 回执详情弹窗 -->
  <view class="popup-mask" wx:if="{{detailVisible}}" bindtap="onCloseDetail"></view>
  <view class="popup-sheet {{detailVisible ? 'show' : ''}}" wx:if="{{detailVisible}}" catchtap="noop">
    <view class="popup-handle"></view>
    <view class="popup-title">回执详情</view>
    <view class="popup-subtitle" wx:if="{{detail.meetingName}}">{{detail.meetingName}}</view>
    <view class="popup-row">
      <text class="popup-label">回执状态</text>
      <text class="popup-value status {{detail.isLeave ? 'leave' : 'attend'}}">{{detail.statusText}}</text>
    </view>
    <view class="popup-row">
      <text class="popup-label">回执时间</text>
      <text class="popup-value">{{detail.timeText}}</text>
    </view>
  </view>
</view>


