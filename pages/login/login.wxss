/* pages/login/login.wxss */
.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0 60rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: 4rpx;
}

.form-card {
  margin: 40rpx 40rpx 0;
  padding: 48rpx 40rpx;
  background: var(--card);
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.04);
}

.field {
  display: flex;
  align-items: center;
  padding: 28rpx 8rpx;
  border-bottom: 1rpx solid var(--border);
}

.field + .field {
  margin-top: 8rpx;
}

.label {
  width: 110rpx;
  font-size: 28rpx;
  color: var(--text);
  font-weight: 600;
  flex-shrink: 0;
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
}

.placeholder {
  color: var(--text-muted);
}

.submit {
  margin-top: 64rpx;
  height: 92rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 46rpx;
  background: var(--primary);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
}

.submit::after {
  border: none;
}

.submit.disabled {
  opacity: 0.6;
}

.safe-bottom {
  height: env(safe-area-inset-bottom);
}
